# ruma. by Al Akhyar - Environment Variables Guide
#
# Repositori ini adalah monorepo:
# - Konfigurasi API & Worker: apps/api/.env (salin dari apps/api/.env.example)
# - Konfigurasi Web PWA:      apps/web/.env (salin dari apps/web/.env.example)
# - Konfigurasi Produksi VPS: deploy/api.env.production.example
#
# Ringkasan variabel utama (Backend - apps/api/.env):
# ----------------------------------------------------
# NODE_ENV=development
# PORT=3000
# APP_URL=http://localhost:5173
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/ruma
#
# Google Workspace OAuth (Login & Drive):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_HD=alakhyar.sch.id
#
# Cloudflare Workers AI (Transkripsi Whisper):
# CF_ACCOUNT_ID=
# CF_API_TOKEN=                # Token dari My Profile > API Tokens (Izin: Workers AI Read)
#
# Cloudflare R2 Storage (Penyimpanan Audio & Retensi 90 Hari):
# R2_ACCOUNT_ID=             # Otomatis mengambil CF_ACCOUNT_ID jika kosong
# R2_ACCESS_KEY_ID=          # Dari R2 > Manage R2 API Tokens (Object Read & Write)
# R2_SECRET_ACCESS_KEY=      # Dari R2 > Manage R2 API Tokens
# R2_BUCKET_NAME=ruma-audio-storage
#
# Google Gemini Gateway (Notulensi):
# GEMINI_BASE_URL=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
