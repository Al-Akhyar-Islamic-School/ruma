NODE_ENV=development
PORT=3000
# URL publik API (dipakai untuk redirect_uri Google): <API_URL>/auth/google/callback
API_URL=http://localhost:3000
# URL PWA; tujuan redirect setelah login
APP_URL=http://localhost:5173
DATABASE_URL=mysql://root:@127.0.0.1:3306/kalam
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domain Google Workspace yang diizinkan (hosted domain), mis. alakhyar.sch.id
GOOGLE_HD=
# Direktori audio mentah (disk VPS); wajib ikut backup
AUDIO_DIR=./data/audio
# Email superadmin (pisah koma). Satu-satunya jalan menjadi superadmin; dicabut dari sini = diturunkan ke guru saat login berikutnya
SUPERADMIN_EMAILS=
# SIM-GTK (opsional): sumber nama resmi & unit GTK. Kosongkan untuk menonaktifkan.
SIMGTK_API_URL=
SIMGTK_TOKEN=

# --- Worker transkripsi & analisis (pnpm worker). Butuh ffmpeg + ffprobe di PATH (apt install ffmpeg) ---
# Cloudflare Workers AI: Account ID + API token dengan izin "Workers AI" (Read/Edit)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Gateway Gemini sekolah (kompatibel OpenAI), mis. http://localhost:8081/v1
GEMINI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Audio dipotong sepanjang ini (detik) sebelum dikirim ke Whisper
WHISPER_SEGMENT_DETIK=600
