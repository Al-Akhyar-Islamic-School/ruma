{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ruma.",
  "version": "0.1.0",
  "identifier": "sch.alakhyar.ruma.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ruma. by Al Akhyar",
        "width": 1020,
        "height": 740,
        "minWidth": 850,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
