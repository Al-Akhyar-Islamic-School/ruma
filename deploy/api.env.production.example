# Salin ke ~/app/shared/.env milik site user API di VPS (chmod 600). JANGAN di-commit dengan nilai asli.
# Daftar lengkap dan penjelasan: apps/api/.env.example dan docs/deploy-cloudpanel.md.

NODE_ENV=production
# Port yang sama dengan "App Port" situs Node.js di CloudPanel. Bind ke 127.0.0.1: hanya Nginx yang boleh menjangkau.
PORT=3100
HOST=127.0.0.1

# URL publik API dan web (harus persis origin yang dipakai browser; cookie sesi same-site lintas subdomain)
API_URL=https://api.ruma.alakhyar.sch.id
APP_URL=https://ruma.alakhyar.sch.id
# Origin tambahan untuk CORS (dipisah koma), misal domain SIMGTK atau domain alternatif
CORS_ORIGINS=https://ruma.alakhyar.sch.id,https://simgtk.alakhyar.sch.id

# Database dibuat di CloudPanel (Databases > Add Database)
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/ruma

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HD=alakhyar.sch.id
SUPERADMIN_EMAILS=

# Audio mentah: di luar folder rilis (rilis dihapus berkala) dan ikut backup
AUDIO_DIR=/home/SITE_USER/app/shared/audio

# Worker (berjalan di dalam proses API). Butuh ffmpeg + ffprobe di VPS
WORKER_INLINE=true
CF_ACCOUNT_ID=
CF_API_TOKEN=
GEMINI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SIMGTK_API_URL=
SIMGTK_TOKEN=
